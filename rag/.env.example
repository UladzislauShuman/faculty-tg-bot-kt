# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Обязательные ---
# Пароль PostgreSQL (придумайте надёжный).
POSTGRES_PASSWORD=
# Секрет для хеша Telegram ID в журнале ответов, не короче 16 символов (например, openssl rand -hex 24).
BOT_HASH_SECRET=

# --- Telegram ---
# Включить приём сообщений из Telegram (true/false).
BOT_TELEGRAM_ENABLED=false
# Токен от @BotFather.
BOT_TELEGRAM_TOKEN=
# Telegram ID администраторов через запятую.
BOT_ADMIN_IDS=

# --- Языковая модель ---
# Профили Spring: docker,yandex (YandexGPT), docker,deepseek, docker,qwen или docker (локальный Ollama на хосте).
# Журнал по умолчанию цветной текст; для JSON добавьте профиль json-logs (например, docker,yandex,json-logs).
BOT_PROFILES=docker,yandex
# Ключ API и идентификатор каталога Yandex Cloud (для профиля yandex).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Ключ DeepSeek (профиль deepseek): https://platform.deepseek.com, раздел API keys.
DEEPSEEK_API_KEY=
# Ключ и адрес Qwen (профиль qwen), Alibaba Cloud Model Studio. Ключ привязан к региону адреса.
# Адрес вида https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1 (в консоли).
QWEN_API_KEY=
QWEN_BASE_URL=
# Необязательно: имя модели Qwen (по умолчанию qwen-plus; проверьте актуальное в консоли).
QWEN_MODEL=

# --- HTTP-вход для проверок без Telegram ---
BOT_HTTP_ENABLED=false
# Ключ в заголовке X-Api-Key, не короче 16 символов.
BOT_HTTP_API_KEY=

# --- Порт на хосте для проб здоровья и HTTP-входа (по умолчанию 8080) ---
BOT_PORT=8080
